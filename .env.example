# Copie ce fichier vers .env et remplis les valeurs
# (Project Settings > API dans ton tableau de bord Supabase)

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Les secrets R2 (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET,
# R2_PUBLIC_BASE_URL) ne vont JAMAIS dans ce fichier : ils se configurent côté
# serveur avec `supabase secrets set`, pour la fonction Edge r2-upload-url.
